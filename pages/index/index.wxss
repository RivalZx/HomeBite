/* ===== 页面整体 ===== */
.page {
  padding: 0 32rpx 160rpx;
  min-height: 100vh;
}

/* ===== 顶部家庭栏 ===== */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 10rpx;
}

.family-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.family-icon {
  font-size: 36rpx;
}

.top-actions {
  display: flex;
  gap: 20rpx;
}

.top-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #F5F0EB;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}

.top-emoji {
  font-size: 28rpx;
}

.top-label {
  font-size: 24rpx;
  color: #666;
}

/* ===== 轮播区 ===== */
.carousel {
  width: 100%;
  height: 340rpx;
  margin-top: 20rpx;
  overflow: visible;
  background: transparent;
}

.carousel-slide {
  width: 100%;
  height: 280rpx;
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.carousel-img {
  width: 100%;
  height: 100%;
}

.carousel-label {
  position: absolute;
  bottom: 20rpx;
  left: 24rpx;
  background: rgba(0,0,0,0.35);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(4px);
}

/* ===== 分类切换 ===== */
.categories {
  display: flex;
  gap: 20rpx;
  margin: 28rpx 0 24rpx;
}

.cate-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: #B6F0C0;
  color: #222;
  transition: all 0.3s;
}

.cate-btn.active {
  background: #A9D8F5;
  box-shadow: 0 4rpx 12rpx rgba(169,216,245,0.4);
}

.cate-emoji {
  font-size: 32rpx;
}

/* ===== 菜品网格 ===== */
.dish-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.dish-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.dish-img-wrap {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 22rpx;
  background: #F0F8FF;
  overflow: hidden;
  position: relative;
  border: 2px solid transparent;
  transition: all 0.2s;
}

.dish-img-wrap.selected {
  border-color: #A9D8F5;
  background: #E8F4FD;
}

.dish-img {
  width: 100%;
  height: 100%;
}

.dish-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dish-emoji {
  font-size: 52rpx;
}

.dish-check {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #A9D8F5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.dish-name {
  font-size: 24rpx;
  color: #222;
  text-align: center;
  line-height: 1.3;
}

.dish-name.selected {
  font-weight: 500;
  color: #222;
}

/* ===== 添加菜品按钮 ===== */
.add-card {
  cursor: pointer;
}

.add-btn {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 22rpx;
  background: #F5F0EB;
  border: 2px dashed #DDD;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #CCC;
  font-weight: 300;
  line-height: 1;
}

.add-label {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* ===== 底部操作区 ===== */
.bottom-spacer {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFDF8;
  padding: 16rpx 32rpx env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04);
}

.bottom-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.wishlist-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 24rpx;
}

.wishlist-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wishlist-icon {
  font-size: 40rpx;
}

.badge {
  position: absolute;
  top: -4rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #FFC5C9;
  color: #222;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.wishlist-text {
  font-size: 22rpx;
  color: #666;
}

.submit-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #A9D8F5;
  color: #222;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.submit-btn:active {
  opacity: 0.8;
}

.submit-btn.disabled {
  opacity: 0.35;
}

.submit-note {
  font-size: 24rpx;
  opacity: 0.7;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

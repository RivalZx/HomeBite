.page {
  padding: 32rpx;
  min-height: 100vh;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-time {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 24rpx;
  color: #A9D8F5;
  background: #F0F8FF;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.order-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.order-dish {
  font-size: 28rpx;
  background: #FFFDF8;
  border: 1px solid #eee;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  color: #222;
}

.order-note {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
  background: #FFFDF8;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
}

.note-tag {
  color: #999;
}

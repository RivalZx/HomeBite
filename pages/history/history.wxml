<view class="page">
  <view class="empty" wx:if="{{orders.length === 0}}">
    <view class="empty-icon">📋</view>
    <view class="empty-text">还没有点餐记录</view>
    <view class="btn-primary" bindtap="goHome">去点餐</view>
  </view>

  <view class="order-list" wx:else>
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <view class="order-header">
        <text class="order-time">{{item.createdAt}}</text>
        <text class="order-status">{{item.status === 'pending' ? '待做' : '已完成'}}</text>
      </view>
      <view class="order-items">
        <text class="order-dish" wx:for="{{item.items}}" wx:for-item="dish" wx:key="index">{{dish.name}}</text>
      </view>
      <view class="order-note" wx:if="{{item.note}}">
        <text class="note-tag">备注：</text>{{item.note}}
      </view>
    </view>
  </view>
</view>

<view class="page">
  <!-- 没有菜品时 -->
  <view class="empty" wx:if="{{dishes.length === 0}}">
    <view class="empty-icon">💭</view>
    <view class="empty-text">还没选菜呢～</view>
    <view class="btn-primary" bindtap="goBack">去选菜</view>
  </view>

  <!-- 菜品列表 -->
  <view class="list" wx:else>
    <view class="list-header">
      <text class="list-title">我想吃这些</text>
      <text class="list-count">{{dishes.length}}道</text>
    </view>

    <view class="dish-item" wx:for="{{dishes}}" wx:key="index">
      <view class="dish-left">
        <view class="dish-placeholder" style="background: {{getColor(item.category)}};">
          <text class="placeholder-emoji">{{getEmoji(item.category)}}</text>
        </view>
        <view class="dish-info">
          <text class="dish-name">{{item.name}}</text>
          <text class="dish-cate">{{getCateName(item.category)}}</text>
        </view>
      </view>
      <view class="dish-right">
        <view class="del-btn" data-index="{{index}}" bindtap="removeDish">
          <text>✕</text>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="note-section">
      <text class="note-label">备注</text>
      <input class="note-input" placeholder="跟大厨说两句～（比如：少放辣）" value="{{note}}" bindinput="onNoteInput" />
    </view>

    <!-- 提交按钮 -->
    <view class="submit-area">
      <view class="btn-primary submit-btn" bindtap="submitOrder">
        告诉大厨 🎉
      </view>
    </view>
  </view>
</view>

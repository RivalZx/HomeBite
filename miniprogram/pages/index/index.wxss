.page { padding: 0 32rpx 160rpx; min-height: 100vh; }

.top-bar { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0 10rpx; }
.top-left { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; margin-left: -12rpx; }
.menu-icon { font-size: 40rpx; color: #222; }
.family-name { display: flex; align-items: center; gap: 10rpx; font-size: 32rpx; font-weight: 600; }
.family-icon { font-size: 36rpx; }
.top-actions { display: flex; gap: 20rpx; }
.top-btn { display: flex; align-items: center; gap: 6rpx; background: #F5F0EB; padding: 8rpx 18rpx; border-radius: 24rpx; }
.top-emoji { font-size: 28rpx; }
.top-label { font-size: 24rpx; color: #666; }

.carousel { width: 100%; height: 340rpx; margin-top: 20rpx; }
.carousel-slide { width: 100%; height: 280rpx; border-radius: 28rpx; overflow: hidden; position: relative; background: #FFFDF8; }
.carousel-img { width: 100%; height: 100%; }
.carousel-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.carousel-emoji { font-size: 80rpx; }
.carousel-label { position: absolute; bottom: 20rpx; left: 24rpx; background: rgba(0,0,0,0.35); color: #fff; font-size: 24rpx; padding: 6rpx 18rpx; border-radius: 20rpx; }

.categories { display: flex; gap: 20rpx; margin: 28rpx 0 24rpx; }
.cate-btn { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; height: 80rpx; border-radius: 40rpx; font-size: 28rpx; font-weight: 500; background: #B6F0C0; color: #222; }
.cate-btn.active { background: #A9D8F5; box-shadow: 0 4rpx 12rpx rgba(169,216,245,0.4); }
.cate-emoji { font-size: 32rpx; }

.dish-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; }
.dish-card { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.dish-img-wrap { width: 100%; height: 210rpx; border-radius: 22rpx; background: #F0F8FF; overflow: hidden; position: relative; border: 2px solid transparent; }
.dish-img-wrap.selected { border-color: #A9D8F5; }
.dish-img { width: 100%; height: 100%; opacity: 0; transition: opacity 0.3s ease; }
.dish-img.loaded { opacity: 1; }
.dish-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.dish-emoji { font-size: 60rpx; }
.dish-check { position: absolute; top: 8rpx; right: 8rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #A9D8F5; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22rpx; font-weight: bold; }
.dish-name { font-size: 26rpx; color: #222; text-align: center; line-height: 1.3; margin-top: 4rpx; }
.dish-name.selected { font-weight: 500; }

.add-btn { width: 100%; height: 210rpx; border-radius: 22rpx; background: #F5F0EB; border: 2px dashed #DDD; display: flex; align-items: center; justify-content: center; }
.add-icon { font-size: 80rpx; color: #CCC; font-weight: 200; }
.add-label { font-size: 24rpx; color: #999; text-align: center; }

.bottom-spacer { height: 140rpx; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #FFFDF8; padding: 16rpx 32rpx env(safe-area-inset-bottom); box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04); }
.bottom-inner { display: flex; align-items: center; gap: 24rpx; }
.wishlist-btn { display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 8rpx 24rpx; }
.wishlist-icon-wrap { position: relative; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.wishlist-icon { font-size: 40rpx; }
.badge { position: absolute; top: -4rpx; right: -8rpx; min-width: 32rpx; height: 32rpx; border-radius: 16rpx; background: #FFC5C9; color: #222; font-size: 22rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; padding: 0 6rpx; }
.wishlist-text { font-size: 22rpx; color: #666; }
.submit-btn { flex: 1; display: flex; align-items: center; justify-content: center; gap: 10rpx; height: 96rpx; border-radius: 48rpx; background: #A9D8F5; color: #222; font-size: 32rpx; font-weight: 500; }
.submit-btn:active { opacity: 0.8; }
.submit-btn.disabled { opacity: 0.35; }
.submit-note { font-size: 24rpx; opacity: 0.7; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }

.loading-state { display: flex; justify-content: center; padding: 100rpx 0; }
.loading-text { font-size: 28rpx; color: #999; }

/* ===== 侧边抽屉 ===== */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 500;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.drawer-mask.show {
  opacity: 1;
  pointer-events: all;
}

.drawer-panel {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 520rpx;
  background: #FFFDF8;
  z-index: 501;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  box-shadow: 4rpx 0 20rpx rgba(0,0,0,0.06);
}

.drawer-panel.open {
  transform: translateX(0);
}

.drawer-inner {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 120rpx 0 40rpx;
}

.drawer-user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 36rpx;
  border-bottom: 1px solid #F0EBE6;
}

.drawer-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #F5F0EB;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.drawer-avatar-img {
  width: 100%;
  height: 100%;
}

.drawer-avatar-text {
  font-size: 44rpx;
}

.drawer-user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.drawer-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}


.drawer-nickname-input {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  background: #F5F0EB;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  height: 50rpx;
  line-height: 50rpx;
  width: 200rpx;
}
.drawer-role {
  font-size: 22rpx;
  color: #A9D8F5;
  background: #F0F8FF;
  padding: 2rpx 16rpx;
  border-radius: 12rpx;
  align-self: flex-start;
}

.drawer-family {
  padding: 24rpx 36rpx;
  border-bottom: 1px solid #F0EBE6;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.drawer-family-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #222;
}

.drawer-member-count {
  font-size: 24rpx;
  color: #999;
}

.drawer-menu {
  flex: 1;
  padding: 16rpx 0;
}

.drawer-menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 36rpx;
  transition: background 0.15s;
}

.drawer-menu-item:active {
  background: #F5F0EB;
}

.drawer-menu-item.disabled {
  opacity: 0.4;
}

.drawer-menu-item.disabled:active {
  background: transparent;
}

.drawer-menu-icon {
  font-size: 32rpx;
  width: 40rpx;
  text-align: center;
}

.drawer-menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #222;
}

.drawer-menu-arrow {
  font-size: 32rpx;
  color: #CCC;
}

.drawer-menu-tag {
  font-size: 20rpx;
  color: #fff;
  background: #FFC5C9;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.drawer-menu-dev {
  font-size: 20rpx;
  color: #CCC;
}

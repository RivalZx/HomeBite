.page { padding: 32rpx; min-height: 100vh; }
.loading { display: flex; justify-content: center; padding: 100rpx 0; }
.loading-text { font-size: 28rpx; color: #999; }

.section { margin-bottom: 48rpx; }

.section-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
  display: block;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  padding: 24rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F5F0EB;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-avatar-text { font-size: 36rpx; }

.member-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.member-name { font-size: 28rpx; font-weight: 500; color: #222; }

.member-role-tag {
  font-size: 20rpx;
  color: #999;
  background: #F5F0EB;
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  align-self: flex-start;
}

.member-role-tag.owner {
  background: #F0F8FF;
  color: #A9D8F5;
}

.member-badge {
  font-size: 22rpx;
  color: #fff;
  background: #A9D8F5;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.invite-section { text-align: center; padding-bottom: 48rpx; }
.invite-btn { width: 100%; height: 96rpx; border-radius: 48rpx; font-size: 30rpx; }
.invite-hint { display: block; margin-top: 16rpx; font-size: 24rpx; color: #999; }

.page { padding: 32rpx; min-height: 100vh; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 200rpx 0; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #999; margin-bottom: 40rpx; }
.list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.list-title { font-size: 34rpx; font-weight: 600; }
.list-count { font-size: 26rpx; color: #999; background: #F5F0EB; padding: 6rpx 20rpx; border-radius: 20rpx; }
.dish-item { display: flex; align-items: center; justify-content: space-between; background: #fff; border-radius: 20rpx; padding: 20rpx; margin-bottom: 16rpx; }
.dish-left { display: flex; align-items: center; gap: 20rpx; }
.dish-placeholder { width: 100rpx; height: 100rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; }
.wishlist-img { width: 100rpx; height: 100rpx; border-radius: 16rpx; }
.placeholder-emoji { font-size: 48rpx; }
.dish-info { display: flex; flex-direction: column; gap: 6rpx; }
.dish-name { font-size: 30rpx; font-weight: 500; }
.dish-cate { font-size: 24rpx; color: #999; }
.del-btn { width: 52rpx; height: 52rpx; border-radius: 50%; background: #F5F0EB; display: flex; align-items: center; justify-content: center; color: #999; font-size: 24rpx; }
.note-section { margin-top: 32rpx; background: #fff; border-radius: 20rpx; padding: 24rpx; }
.note-label { font-size: 28rpx; font-weight: 500; display: block; margin-bottom: 16rpx; }
.note-input { width: 100%; height: 80rpx; font-size: 28rpx; background: #FFFDF8; border-radius: 12rpx; padding: 0 16rpx; border: 1px solid #eee; }
.submit-area { margin-top: 48rpx; padding-bottom: 48rpx; }
.submit-btn { height: 100rpx; border-radius: 50rpx; font-size: 34rpx; }

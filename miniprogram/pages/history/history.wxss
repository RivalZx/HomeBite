.page { padding: 32rpx; min-height: 100vh; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 200rpx 0; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #999; margin-bottom: 40rpx; }
.loading { display: flex; justify-content: center; padding: 100rpx 0; }
.loading-text { font-size: 28rpx; color: #999; }
.order-list { display: flex; flex-direction: column; gap: 20rpx; }

.order-card { background: #fff; border-radius: 24rpx; padding: 28rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); }
.order-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.order-date-block { display: flex; flex-direction: column; align-items: center; background: #FFF5F0; border-radius: 14rpx; padding: 8rpx 16rpx; min-width: 72rpx; }
.order-date-day { font-size: 32rpx; font-weight: 700; color: #222; line-height: 1.2; }
.order-date-month { font-size: 20rpx; color: #999; }
.order-datetime { flex: 1; }
.order-date-text { font-size: 28rpx; font-weight: 500; color: #222; display: block; }
.order-time-text { font-size: 22rpx; color: #999; }
.order-status { font-size: 22rpx; color: #A9D8F5; background: #F0F8FF; padding: 6rpx 18rpx; border-radius: 16rpx; }
.order-by { display: flex; align-items: center; gap: 8rpx; margin-bottom: 12rpx; }
.order-by-icon { font-size: 24rpx; }
.order-by-name { font-size: 24rpx; color: #999; }
.order-items { display: flex; flex-wrap: wrap; gap: 12rpx; }
.order-dish { font-size: 28rpx; background: #FFFDF8; border: 1px solid #eee; padding: 8rpx 20rpx; border-radius: 16rpx; color: #333; }
.order-note { margin-top: 16rpx; font-size: 26rpx; color: #666; background: #FFFDF8; padding: 12rpx 16rpx; border-radius: 12rpx; border-left: 4rpx solid #FFC5C9; }
.note-tag { color: #999; }

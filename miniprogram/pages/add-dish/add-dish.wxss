.page { padding: 32rpx; min-height: 100vh; }
.form-section { display: flex; flex-direction: column; gap: 36rpx; }
.form-group { display: flex; flex-direction: column; gap: 16rpx; }
.form-label { font-size: 28rpx; font-weight: 500; color: #222; }
.photo-upload { width: 200rpx; height: 200rpx; border-radius: 24rpx; overflow: hidden; border: 2px dashed #DDD; background: #FAFAFA; }
.photo-preview { width: 100%; height: 100%; }
.photo-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }
.photo-icon { font-size: 48rpx; }
.photo-text { font-size: 24rpx; color: #999; }
.form-input { height: 88rpx; background: #fff; border-radius: 16rpx; padding: 0 24rpx; font-size: 28rpx; border: 1.5px solid #eee; }
.cate-picker { display: flex; gap: 16rpx; }
.cate-option { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 40rpx; background: #F5F0EB; font-size: 26rpx; }
.cate-option.active { background: #A9D8F5; font-weight: 500; }
.upload-progress { text-align: center; }
.upload-text { font-size: 26rpx; color: #999; }
.delete-area { margin-top: 80rpx; text-align: center; }
.delete-btn { font-size: 28rpx; color: #FF8A8A; padding: 20rpx; border-top: 1px solid #eee; border-bottom: 1px solid #eee; }
.delete-btn:active { background: #FFF5F5; }
.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; padding: 16rpx 32rpx env(safe-area-inset-bottom); background: #FFFDF8; }
.bottom-actions .btn-primary { height: 96rpx; border-radius: 48rpx; font-size: 32rpx; width: 100%; }

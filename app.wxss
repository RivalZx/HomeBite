/**
 * HomeBite 全局样式
 * 色彩方案：低饱和马卡龙色
 * 背景 #FFFDF8 / 主蓝 #A9D8F5 / 分类绿 #B6F0C0 / 轮播粉 #FFC5C9
 * 强调黄 #FFE88A / 深色 #222 / 辅助 #666
 */

page {
  background-color: #FFFDF8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #222;
  box-sizing: border-box;
}

/* 通用按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  border-radius: 16px;
  font-size: 16px;
  font-weight: 500;
  background: #A9D8F5;
  color: #222;
  border: none;
  padding: 0 24px;
  transition: opacity 0.2s;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-primary.disabled {
  opacity: 0.4;
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  border-radius: 14px;
  font-size: 15px;
  background: transparent;
  color: #222;
  border: 1.5px solid #222;
  padding: 0 20px;
}

.btn-outline:active {
  background: rgba(0,0,0,0.04);
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

/* 弹窗遮罩 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 100;
}
